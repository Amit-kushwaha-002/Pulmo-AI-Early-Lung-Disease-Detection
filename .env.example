# Server Port
PORT=3000

# MongoDB Connection String (MongoDB Atlas for Vercel production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pulmoai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pulmoai?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Local Python Executable Path (for local TensorFlow model execution)
PYTHON_PATH=python

# Optional Remote AI Microservice URL (e.g., hosted on Render or Hugging Face Spaces)
# AI_API_URL=https://your-ai-service.onrender.com/predict

# Optional MySQL Configuration (if using external MySQL for contact inquiries)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Pulmoai
MYSQL_PORT=3306
