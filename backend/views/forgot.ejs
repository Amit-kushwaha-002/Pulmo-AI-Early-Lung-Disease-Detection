<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - LungAI</title>
    <link rel="stylesheet" href="/forgot.css">
    <link rel="icon" href="/images/logo.jpg">
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <div class="navbar">
            <div class="logo">
                <img src="/images/logo.jpg" alt="PulmoAi"> <span>PulmoAi</span>
            </div>
            <ul class="nav-links">
                <li><a href="/home" style="text-decoration:none; color:#333;">Home</a></li>
                <li><a href="/login" style="text-decoration:none; color:#333;">Login</a></li>
            </ul>
        </div>
    </header>

    <!-- FORGOT PASSWORD -->
    <section class="forgot-section">
        <div class="forgot-card">
            <div class="icon">
                <img src="/images/forgot.jpg" alt="Forgot" style="border-radius:50%;">
            </div>

            <h1>Forgot Password</h1>

            <p class="info">
                Enter your registered email address to receive password reset instructions.
            </p>

            <!-- EMAIL FORM -->
            <form id="emailForm" onsubmit="event.preventDefault(); sendOTP();">
                <label for="email">Email Address</label>
                <input id="email" type="email" placeholder="Enter your email" required>

                <button type="submit" class="reset-btn" id="sendOtpBtn">Send OTP</button>

                <p class="back" style="margin-top:15px;">Remember your password?
                    <span><a href="/login">Login</a></span>
                </p>
            </form>

            <!-- OTP SECTION -->
            <div id="otpSection" style="display:none; margin-top:20px;">
                <h3>Enter 6-Digit OTP</h3>
                <input id="otp" type="text" maxlength="6" placeholder="Enter OTP (e.g. 123456)" style="margin-top:10px;">
                <button type="button" class="reset-btn" onclick="verifyOTP()">Verify OTP</button>
            </div>

            <!-- RESET PASSWORD SECTION -->
            <div id="resetSection" style="display:none; margin-top:20px;">
                <h3>Reset Password</h3>
                <input id="newPassword" type="password" placeholder="New Password (min 6 chars)" style="margin-top:10px;">
                <input id="confirmPassword" type="password" placeholder="Confirm Password">
                <button type="button" class="reset-btn" onclick="resetPassword()">Reset Password</button>
            </div>

        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="footer-container">
            <div class="footer-left">
                <p>© Copyright LungAI Diagnosis System</p>
                <p class="disclaimer">
                    This system assists doctors in identifying lung diseases early,
                    improving diagnosis speed and helping better patient care.
                </p>
            </div>
            <div class="footer-right">
                <h4>Quick Links</h4>
                <p><a href="/home">Home</a> | <a href="/about">About</a> | <a href="/settings">Setting</a></p>
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT -->
    <script src="/forgot.js"></script>
</body>
</html>
